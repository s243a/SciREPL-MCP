{
  "name": "scirepl-mcp-broker",
  "version": "0.1.0",
  "private": true,
  "description": "Auditable app-connected MCP, remote-agent, and optional terminal bridge for SciREPL Pro",
  "type": "module",
  "bin": {
    "scirepl-mcp-broker": "src/broker.mjs",
    "scirepl-mcp-setup": "scripts/setup.mjs"
  },
  "files": [
    "src",
    "scripts",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "postinstall": "node scripts/prepare-node-pty.mjs",
    "setup": "node scripts/setup.mjs",
    "start": "node src/broker.mjs",
    "check": "node --check src/broker.mjs && node --check src/workspace.mjs && node --check src/utf8-pipes.mjs && node --check src/node-pty-support.mjs && node --check scripts/setup.mjs && node --check scripts/prepare-node-pty.mjs",
    "test": "node test/node-pty-support.test.mjs && node test/setup.test.mjs && node test/security.test.mjs && node test/unmanaged-workspace.test.mjs && node test/broker.test.mjs && node test/missing-agent.test.mjs && node test/utf8-agent.test.mjs && node test/term.test.mjs",
    "test:node-pty-support": "node test/node-pty-support.test.mjs",
    "test:setup": "node test/setup.test.mjs",
    "test:security": "node test/security.test.mjs",
    "test:unmanaged": "node test/unmanaged-workspace.test.mjs",
    "test:broker": "node test/broker.test.mjs",
    "test:term": "node test/term.test.mjs",
    "test:agent": "node test/agent.test.mjs",
    "test:missing-agent": "node test/missing-agent.test.mjs",
    "test:utf8-agent": "node test/utf8-agent.test.mjs",
    "test:session": "node test/session.test.mjs",
    "test:oneshot": "node test/oneshot.test.mjs",
    "test:oneshot:notebook": "node test/oneshot-notebook.test.mjs",
    "audit": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "scirepl",
    "mcp",
    "model-context-protocol",
    "notebook",
    "android",
    "remote-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s243a/SciREPL-MCP.git",
    "directory": "packages/broker"
  },
  "homepage": "https://github.com/s243a/SciREPL-MCP#readme",
  "bugs": {
    "url": "https://github.com/s243a/SciREPL-MCP/issues"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
